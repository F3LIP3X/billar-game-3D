{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && (data.child('seats').child('0').val() === auth.uid || data.child('seats').child('1').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('seats').child('0').val() === auth.uid) || (data.child('host').val() === auth.uid && !data.child('seats').child('1').exists() && !newData.exists()))",
        ".validate": "$room.matches(/^[A-Z2-9]{5}$/)",
        "host": {
          ".read": "auth != null"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "seats": {
          ".read": "auth != null",
          "$seat": {
            ".validate": "($seat === '0' || $seat === '1') && newData.isString() && newData.val().length < 40",
            ".write": "auth != null && root.child('rooms').child($room).child('host').exists() && !data.exists() && newData.val() === auth.uid && root.child('rooms').child($room).child('seats').child('0').val() !== auth.uid"
          }
        },
        "names": {
          "$seat": {
            ".validate": "newData.isString() && newData.val().length <= 20",
            ".write": "auth != null && root.child('rooms').child($room).child('seats').child($seat).val() === auth.uid"
          }
        },
        "presence": {
          "$seat": {
            ".validate": "newData.isBoolean()",
            ".write": "auth != null && root.child('rooms').child($room).child('seats').child($seat).val() === auth.uid"
          }
        },
        "rematch": {
          "$seat": {
            ".validate": "newData.isBoolean()",
            ".write": "auth != null && root.child('rooms').child($room).child('seats').child($seat).val() === auth.uid"
          }
        },
        "chat": {
          "$id": {
            ".validate": "newData.hasChildren(['by', 'text', 't']) && (newData.child('by').val() === '0' || newData.child('by').val() === '1') && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 200 && newData.child('t').val() === now",
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($room).child('seats').child(newData.child('by').val()).val() === auth.uid"
          }
        },
        "state": {
          ".write": "auth != null && ((root.child('rooms').child($room).child('host').val() === auth.uid && (!data.exists() || data.child('phase').val() === 'over')) || (data.exists() && root.child('rooms').child($room).child('seats').child(data.child('turn').val()).val() === auth.uid))",
          ".validate": "newData.hasChildren(['turn', 'phase'])",
          "turn": {
            ".validate": "newData.val() === '0' || newData.val() === '1'"
          },
          "phase": {
            ".validate": "newData.val() === 'placing' || newData.val() === 'aiming' || newData.val() === 'over'"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        },
        "shot": {
          ".write": "auth != null && root.child('rooms').child($room).child('state').exists() && root.child('rooms').child($room).child('seats').child(root.child('rooms').child($room).child('state').child('turn').val()).val() === auth.uid"
        },
        "aim": {
          ".write": "auth != null && root.child('rooms').child($room).child('state').exists() && root.child('rooms').child($room).child('seats').child(root.child('rooms').child($room).child('state').child('turn').val()).val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
